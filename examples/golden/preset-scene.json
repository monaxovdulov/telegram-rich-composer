{
  "schema_version": "1.0",
  "surface": {
    "channel": "telegram",
    "chat_type": "private",
    "locale": "en",
    "is_draft": false,
    "capabilities": {
      "rich_blocks": true,
      "rich_markdown": true,
      "rich_html": true,
      "legacy_html": true,
      "legacy_markdown": true,
      "plain_album": true,
      "media_spoiler": true,
      "details_nested_media": true,
      "controlled_local_upload": false
    }
  },
  "selection": {
    "mode": "rich",
    "pattern": "scene",
    "density": "showcase",
    "reason_codes": [
      "user_requested_rich"
    ],
    "showcase_requested": true
  },
  "summary": "scene",
  "blocks": [
    {
      "type": "slideshow",
      "blocks": [
        {
          "type": "photo",
          "media_id": "scene1",
          "caption": {
            "text": "Scene 1"
          }
        },
        {
          "type": "photo",
          "media_id": "scene2",
          "caption": {
            "text": "Scene 2"
          }
        },
        {
          "type": "photo",
          "media_id": "scene3",
          "caption": {
            "text": "Scene 3"
          }
        }
      ],
      "caption": {
        "text": "Three ordered frames"
      }
    },
    {
      "type": "pull_quote",
      "text": "Motion is supplied by the reader.",
      "credit": "Scene note"
    },
    {
      "type": "paragraph",
      "text": "Swipe order carries the narrative."
    },
    {
      "type": "details",
      "summary": "Credits",
      "open": false,
      "blocks": [
        {
          "type": "paragraph",
          "text": "Independent demonstration assets."
        }
      ]
    }
  ],
  "media": [
    {
      "id": "scene1",
      "kind": "photo",
      "source": {
        "type": "telegram_file_id",
        "file_id": "telegram-scene1"
      }
    },
    {
      "id": "scene2",
      "kind": "photo",
      "source": {
        "type": "telegram_file_id",
        "file_id": "telegram-scene2"
      }
    },
    {
      "id": "scene3",
      "kind": "photo",
      "source": {
        "type": "telegram_file_id",
        "file_id": "telegram-scene3"
      }
    }
  ],
  "delivery": {
    "reply": "inherit",
    "thread": "inherit",
    "silent": false,
    "protect_content": false,
    "entity_detection": "explicit_only"
  },
  "fallback": {
    "ladder": [
      "rich_blocks",
      "rich_markdown",
      "rich_html",
      "legacy_html",
      "legacy_markdown",
      "plain_album"
    ],
    "allow_feature_loss": true,
    "on_unknown_delivery": "stop_and_reconcile"
  },
  "diagnostics": {
    "warnings": []
  }
}
