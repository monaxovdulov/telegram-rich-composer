{
  "schema_version": "1.0",
  "surface": {
    "channel": "telegram",
    "chat_type": "private",
    "locale": "en",
    "is_draft": false,
    "capabilities": {
      "rich_blocks": true,
      "rich_markdown": true,
      "rich_html": true,
      "legacy_html": true,
      "legacy_markdown": true,
      "plain_album": true,
      "media_spoiler": true,
      "details_nested_media": true,
      "controlled_local_upload": false
    }
  },
  "selection": {
    "mode": "rich",
    "pattern": "title-pullquote",
    "density": "standard",
    "reason_codes": [
      "structure_improves_scan"
    ],
    "showcase_requested": false
  },
  "summary": "title pullquote",
  "blocks": [
    {
      "type": "heading",
      "level": 1,
      "text": "Signal at dawn"
    },
    {
      "type": "pull_quote",
      "text": "The quiet state is still a state.",
      "credit": "Field note · Issue 07"
    }
  ],
  "media": [],
  "delivery": {
    "reply": "inherit",
    "thread": "inherit",
    "silent": false,
    "protect_content": false,
    "entity_detection": "explicit_only"
  },
  "fallback": {
    "ladder": [
      "rich_blocks",
      "rich_markdown",
      "rich_html",
      "legacy_html",
      "legacy_markdown",
      "plain_album"
    ],
    "allow_feature_loss": true,
    "on_unknown_delivery": "stop_and_reconcile"
  },
  "diagnostics": {
    "warnings": []
  }
}
