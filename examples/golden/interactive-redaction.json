        {
          "type": "spoiler",
          "content": [
            {
              "type": "text",
              "text": "The signal was expected."
            }
          ]
        }
      ]
    },
    {
      "type": "photo",
      "media_id": "reveal",
      "spoiler": true,
      "caption": {
        "text": "Related frame",
        "credit": "Archive"
      }
    }
  ],
  "media": [
    {
      "id": "reveal",
      "kind": "photo",
