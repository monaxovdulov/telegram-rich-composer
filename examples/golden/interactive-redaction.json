      "plain_album": true,
      "media_spoiler": true,
      "details_nested_media": true,
      "controlled_local_upload": false
    }
  },
  "selection": {
    "mode": "rich",
    "pattern": "interactive-redaction",
    "density": "standard",
    "reason_codes": [
      "structure_improves_scan"
    ],
    "showcase_requested": false
