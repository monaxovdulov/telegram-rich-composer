{
  "schema_version": "1.0",
  "surface": {
    "channel": "telegram",
    "chat_type": "private",
    "locale": "en",
    "is_draft": false,
    "capabilities": {
      "rich_blocks": true,
      "rich_markdown": true,
      "rich_html": true,
      "legacy_html": true,
      "legacy_markdown": true,
      "plain_album": true,
      "media_spoiler": true,
      "details_nested_media": true,
      "controlled_local_upload": false
    }
  },
  "selection": {
    "mode": "rich",
    "pattern": "hidden-sound-note",
    "density": "standard",
    "reason_codes": [
      "structure_improves_scan"
    ],
    "showcase_requested": false
  },
  "summary": "hidden sound note",
