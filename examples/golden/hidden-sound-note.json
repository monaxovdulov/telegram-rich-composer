          "type": "voice_note",
          "media_id": "voice",
          "duration_label": "0:18",
          "caption": {
            "text": "Optional field recording"
          }
        }
      ]
    }
  ],
  "media": [
    {
      "id": "voice",
      "kind": "voice_note",
      "source": {
        "type": "telegram_file_id",
        "file_id": "telegram-voice"
      }
    }
  ],
  "delivery": {
    "reply": "inherit",
    "thread": "inherit",
    "silent": false,
    "protect_content": false,
    "entity_detection": "explicit_only"
