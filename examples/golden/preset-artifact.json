      "rich_blocks",
      "rich_markdown",
      "rich_html",
      "legacy_html",
      "legacy_markdown",
      "plain_album"
    ],
    "allow_feature_loss": true,
    "on_unknown_delivery": "stop_and_reconcile"
  },
  "diagnostics": {
    "warnings": []
  }
}
