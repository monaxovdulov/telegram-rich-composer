{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://telegram-rich-composer.dev/schemas/composition-spec.schema.json",
  "title": "Telegram Rich Composer CompositionSpec",
  "description": "Harness-independent semantic structure for one Telegram response.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "surface",
    "selection",
    "summary",
    "blocks",
    "media",
    "delivery",
    "fallback",
    "diagnostics"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "surface": { "$ref": "#/$defs/surface" },
    "selection": { "$ref": "#/$defs/selection" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "blocks": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/block" }
    },
    "media": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/mediaReference" }
    },
    "delivery": { "$ref": "#/$defs/delivery" },
    "fallback": { "$ref": "#/$defs/fallback" },
    "diagnostics": { "$ref": "#/$defs/diagnostics" }
  },
  "$defs": {
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "chat_type", "locale", "is_draft", "capabilities"],
      "properties": {
        "channel": { "const": "telegram" },
        "chat_type": {
          "enum": ["private", "group", "supergroup", "channel", "unknown"]
        },
        "locale": { "type": "string", "minLength": 2, "maxLength": 35 },
        "is_draft": { "type": "boolean" },
        "capabilities": {
          "type": "object",
          "additionalProperties": { "type": "boolean" },
          "propertyNames": { "pattern": "^[a-z][a-z0-9_.-]{0,63}$" }
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "pattern", "density", "reason_codes"],
      "properties": {
        "mode": { "enum": ["plain", "rich"] },
        "pattern": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "density": { "enum": ["calm", "standard", "showcase"] },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" }
        },
        "showcase_requested": { "type": "boolean", "default": false }
      }
    },
    "richText": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/inlineNode" }
        }
      ]
    },
    "inlineNode": {
      "oneOf": [
        { "$ref": "#/$defs/textNode" },
        { "$ref": "#/$defs/containerInlineNode" },
        { "$ref": "#/$defs/linkNode" },
        { "$ref": "#/$defs/anchorLinkNode" },
        { "$ref": "#/$defs/referenceNode" },
        { "$ref": "#/$defs/referenceLinkNode" },
        { "$ref": "#/$defs/customEmojiNode" },
        { "$ref": "#/$defs/inlineFormulaNode" }
      ]
    },
    "textNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string" }
      }
    },
    "containerInlineNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": {
          "enum": [
            "bold",
            "italic",
            "underline",
            "strikethrough",
            "spoiler",
            "mark",
            "code",
            "subscript",
            "superscript"
          ]
        },
        "content": { "$ref": "#/$defs/richText" }
      }
    },
    "linkNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content", "href"],
      "properties": {
        "type": { "const": "link" },
        "content": { "$ref": "#/$defs/richText" },
        "href": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "anchorLinkNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content", "target"],
      "properties": {
        "type": { "const": "anchor_link" },
        "content": { "$ref": "#/$defs/richText" },
        "target": { "type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9_.:-]*$" }
      }
    },
    "referenceNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "content"],
      "properties": {
        "type": { "const": "reference" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "content": { "$ref": "#/$defs/richText" }
      }
    },
    "referenceLinkNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target", "content"],
      "properties": {
        "type": { "const": "reference_link" },
        "target": { "type": "string", "minLength": 1, "maxLength": 128 },
        "content": { "$ref": "#/$defs/richText" }
      }
    },
    "customEmojiNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "custom_emoji_id", "alt"],
      "properties": {
        "type": { "const": "custom_emoji" },
        "custom_emoji_id": { "type": "string", "pattern": "^[0-9]+$" },
        "alt": { "type": "string", "minLength": 1, "maxLength": 16 },
        "pack": { "type": "string", "maxLength": 128 }
      }
    },
    "inlineFormulaNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "expression"],
      "properties": {
        "type": { "const": "formula" },
        "expression": { "type": "string", "minLength": 1 }
      }
    },
    "caption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "$ref": "#/$defs/richText" },
        "credit": { "$ref": "#/$defs/richText" }
      }
    },
    "paragraphBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "paragraph" },
        "text": { "$ref": "#/$defs/richText" }
      }
    },
    "headingBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "level", "text"],
      "properties": {
        "type": { "const": "heading" },
        "level": { "type": "integer", "minimum": 1, "maximum": 6 },
        "text": { "$ref": "#/$defs/richText" }
      }
    },
    "dividerBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": { "type": { "const": "divider" } }
    },
    "codeBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "enum": ["code", "preformatted"] },
        "text": { "type": "string" },
        "language": { "type": "string", "maxLength": 64 }
      }
    },
    "formulaBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "expression"],
      "properties": {
        "type": { "const": "formula" },
        "expression": { "type": "string", "minLength": 1 }
      }
    },
    "footerBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "footer" },
        "text": { "$ref": "#/$defs/richText" }
      }
    },
    "anchorBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name"],
      "properties": {
        "type": { "const": "anchor" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.:-]+$" }
      }
    },
    "listItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "$ref": "#/$defs/richText" },
        "blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/block" }
        },
        "checked": { "type": "boolean" },
        "value": { "type": "integer" }
      }
    },
    "listBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": { "enum": ["list", "checklist"] },
        "ordered": { "type": "boolean", "default": false },
        "start": { "type": "integer" },
        "marker_type": { "enum": ["1", "a", "A", "i", "I"] },
        "reversed": { "type": "boolean", "default": false },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/listItem" }
        }
      }
    },
    "quoteBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "blocks"],
      "properties": {
        "type": { "const": "quote" },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/block" }
        },
        "credit": { "$ref": "#/$defs/richText" }
      }
    },
    "pullQuoteBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "pull_quote" },
        "text": { "$ref": "#/$defs/richText" },
        "credit": { "$ref": "#/$defs/richText" }
      }
    },
    "tableCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "$ref": "#/$defs/richText" },
        "header": { "type": "boolean", "default": false },
        "colspan": { "type": "integer", "minimum": 1, "maximum": 20 },
        "rowspan": { "type": "integer", "minimum": 1, "maximum": 500 },
        "align": { "enum": ["left", "center", "right"] },
        "valign": { "enum": ["top", "middle", "bottom"] }
      }
    },
    "tableBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "rows"],
      "properties": {
        "type": { "const": "table" },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": { "$ref": "#/$defs/tableCell" }
          }
        },
        "bordered": { "type": "boolean", "default": false },
        "striped": { "type": "boolean", "default": false },
        "caption": { "$ref": "#/$defs/richText" }
      }
    },
    "detailsBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "summary", "open", "blocks"],
      "properties": {
        "type": { "const": "details" },
        "summary": { "$ref": "#/$defs/richText" },
        "open": { "type": "boolean" },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/block" }
        }
      }
    },
    "mapBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "latitude", "longitude", "zoom", "width", "height"],
      "properties": {
        "type": { "const": "map" },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "zoom": { "type": "integer", "minimum": 0, "maximum": 24 },
        "width": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "height": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "caption": { "$ref": "#/$defs/caption" }
      }
    },
    "mediaBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "media_id"],
      "properties": {
        "type": { "enum": ["photo", "video", "animation", "audio", "voice_note"] },
        "media_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
        "caption": { "$ref": "#/$defs/caption" },
        "spoiler": { "type": "boolean", "default": false },
        "duration_label": { "type": "string", "maxLength": 64 }
      }
    },
    "galleryBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "blocks"],
      "properties": {
        "type": { "enum": ["collage", "slideshow"] },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": { "$ref": "#/$defs/mediaBlock" }
        },
        "caption": { "$ref": "#/$defs/caption" }
      }
    },
    "thinkingBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "thinking" },
        "text": { "$ref": "#/$defs/richText" }
      }
    },
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/paragraphBlock" },
        { "$ref": "#/$defs/headingBlock" },
        { "$ref": "#/$defs/dividerBlock" },
        { "$ref": "#/$defs/codeBlock" },
        { "$ref": "#/$defs/formulaBlock" },
        { "$ref": "#/$defs/footerBlock" },
        { "$ref": "#/$defs/anchorBlock" },
        { "$ref": "#/$defs/listBlock" },
        { "$ref": "#/$defs/quoteBlock" },
        { "$ref": "#/$defs/pullQuoteBlock" },
        { "$ref": "#/$defs/tableBlock" },
        { "$ref": "#/$defs/detailsBlock" },
        { "$ref": "#/$defs/mapBlock" },
        { "$ref": "#/$defs/mediaBlock" },
        { "$ref": "#/$defs/galleryBlock" },
        { "$ref": "#/$defs/thinkingBlock" }
      ]
    },
    "mediaReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
        "kind": { "enum": ["photo", "video", "animation", "audio", "voice_note"] },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "file_id"],
              "properties": {
                "type": { "const": "telegram_file_id" },
                "file_id": { "type": "string", "minLength": 1, "maxLength": 1024 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "url"],
              "properties": {
                "type": { "const": "url" },
                "url": { "type": "string", "pattern": "^https?://", "maxLength": 2048 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "path"],
              "properties": {
                "type": { "const": "local_path" },
                "path": { "type": "string", "minLength": 1, "maxLength": 4096 }
              }
            }
          ]
        },
        "mime_type": { "type": "string", "maxLength": 127 },
        "filename": { "type": "string", "maxLength": 255 }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reply", "thread", "silent", "protect_content", "entity_detection"],
      "properties": {
        "reply": { "enum": ["inherit", "none", "required"] },
        "thread": { "enum": ["inherit", "none"] },
        "silent": { "type": "boolean" },
        "protect_content": { "type": "boolean" },
        "entity_detection": { "enum": ["auto", "explicit_only"] },
        "reply_markup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["purpose", "inline_keyboard"],
          "properties": {
            "purpose": { "enum": ["choice", "action"] },
            "inline_keyboard": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["text"],
                  "properties": {
                    "text": { "type": "string", "minLength": 1, "maxLength": 64 },
                    "callback_data": { "type": "string", "minLength": 1, "maxLength": 64 },
                    "url": { "type": "string", "pattern": "^https://", "maxLength": 2048 }
                  },
                  "oneOf": [
                    { "required": ["callback_data"] },
                    { "required": ["url"] }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ladder", "allow_feature_loss", "on_unknown_delivery"],
      "properties": {
        "ladder": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["rich_blocks", "rich_markdown", "rich_html", "legacy_html", "legacy_markdown", "plain_album"]
          }
        },
        "allow_feature_loss": { "type": "boolean" },
        "on_unknown_delivery": { "const": "stop_and_reconcile" }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warnings"],
      "properties": {
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
              "message": { "type": "string", "minLength": 1 },
              "path": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
